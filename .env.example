# AI
GROQ_API_KEY=
GEMINI_API_KEY=
# 본문 생성 (기본 gemini-3.1-flash-lite — fast와 동일)
# GEMINI_MODEL_BODY=gemini-3.1-flash-lite
# 리서치·제목·메타·이미지계획
# GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# 둘 다 비우면 위 기본값. GEMINI_MODEL만 있으면 fast/body 모두 그 모델 사용
# Imagen 4 모델별 일일 생성 한도 (기본 25, 3모델 순차 사용 → 최대 75장/일)
# IMAGEN_DAILY_LIMIT_PER_MODEL=25
# RPM 기준 자동 간격: body/fast 기본 20회/분→약 3.5초 (2.5-flash 쓸 때만 body 5회/분→13초)
# GEMINI_BODY_RPM=20
# GEMINI_FAST_RPM=20
# GEMINI_BODY_MIN_INTERVAL_SEC=3.5
# GEMINI_FAST_MIN_INTERVAL_SEC=3.5

# NVIDIA NIM (텍스트 벤치마크·이미지 FLUX) — build.nvidia.com API Key (nvapi-...)
NVIDIA_API_KEY=
# NAVER_CREATE_FETCH_IMAGES=1

# 네이버 Open API (키워드·참고자료)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고 API (선택 — 검색량·연관키워드)
NAVER_AD_ACCESS_LICENSE=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 네이버 블로그 발행
# 로그인 ID(NAVER_ID)와 블로그 주소 ID가 다를 수 있음
# 예: blog.naver.com/ifsae42 → NAVER_BLOG_ID=ifsae42
NAVER_BLOG_ID=
# NAVER_WRITE_URL=https://blog.naver.com/ifsae42?Redirect=Write&
NAVER_ID=
NAVER_PASSWORD=
# 업로드 시 Chrome 창 숨김 (1=headless, 0=창 표시). publish.yaml headless 와 병용 — CLI --headless 가 최우선
# NAVER_HEADLESS=1
# Smart Editor ONE 제목/본문 id (페이지마다 바뀔 수 있음)
NAVER_EDITOR_TITLE_ID=
NAVER_EDITOR_BODY_ID=
NAVER_STORAGE_STATE=.auth/storage_state.json
# 로그인 속도: 1=fill 빠른 로그인(기본), 0=한 글자씩 천천히
# NAVER_LOGIN_FAST=1
